# Cadence — optional cross-device sync (Supabase)
#
# Cadence works fully offline with NO account. These vars are only needed if
# you want tasks to sync across your phone, laptop, etc. See SYNC.md for setup.
#
# Copy this file to `.env`, fill in the values from your Supabase project
# (Project Settings → API), then rebuild. Sync activates automatically.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# BoDay Agent (phase 5). Cloud Run URL, no trailing slash. Empty disables BoDay Agent.
# Set it in your local .env before `npm run build && npx wrangler deploy`.
VITE_AGENT_URL=
